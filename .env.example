# Token Swap Bot — Secrets
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The script reads these from environment variables.
# For convenience, you can "source .env" before running.

# ── Network ──────────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org

# ── Master Wallet (Gas Sponsor / Whitelisted Caller) ─
# This wallet must be whitelisted on the GasSponsor contract.
# It signs and sends all execute() transactions.
# GasSponsor Contract: https://github.com/kinged007/gas-sponsor-contract
MASTER_WALLET_ADDRESS=
MASTER_PRIVATE_KEY=

# ── Deployed Contracts ───────────────────────────────
GAS_SPONSOR_CONTRACT=
PANCAKE_ROUTER=0x1b81D678ffb9C0263b24A97847620C99d213eB14
PANCAKE_QUOTER=0xB048Bbc1Ee6b733FFfCFb9e9CeF7375518e25997

# ── Collection Wallet (receives swapped tokens) ─────
# Leave blank to skip the collection transfer step.
COLLECTION_WALLET=

# ── Safety Limits ────────────────────────────────────
# Max slippage tolerance in basis points (200 = 2%)
MAX_SLIPPAGE_BPS=200

# Max BNB the gas pool can spend per day before halting
DAILY_GAS_LIMIT_BNB=0.5
# Token Swap Bot — Secrets
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The script reads these from environment variables.
# For convenience, you can "source .env" before running.
